{
  "name": "inspection-app",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons:build": "pwa-assets-generator",
    "test": "vitest run",
    "test:watch": "vitest",
    "snippets:build": "node scripts/build-snippets.ts",
    "test:e2e": "playwright test",
    "fixtures:drawings": "node scripts/build-drawings.ts",
    "docs:shots": "playwright test --project ipad-webkit --grep @shots",
    "docs:build": "node scripts/build-manual.ts"
  },
  "dependencies": {
    "@fontsource/figtree": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "exceljs": "4.4.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.50.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
